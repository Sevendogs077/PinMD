{
  "name": "pinmd",
  "version": "1.0.1",
  "description": "一个极简的桌面悬浮Markdown便签",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.Sevendogs077.pinmd",
    "productName": "PinMD",
    "copyright": "Copyright © 2026 Sevendogs077",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sevendogs077/PinMD.git"
  },
  "keywords": [
    "markdown",
    "electron",
    "note"
  ],
  "author": "Sevendogs077",
  "license": "GPL-3.0",
  "dependencies": {
    "marked": "^11.2.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Sevendogs077/PinMD/issues"
  },
  "homepage": "https://github.com/Sevendogs077/PinMD#readme"
}
